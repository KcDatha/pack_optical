---
import { CHIPS, GREETING } from '../lib/chat';
---
<button class="chat-fab" id="chatFab" aria-label="Chat with Pack Optical" aria-expanded="false" aria-controls="chatPanel" title="Chat with us"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-3.6-.8L3 20.5l1.5-4.6A8.3 8.3 0 0 1 3 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5Z"/><circle cx="8.5" cy="11.5" r=".6" fill="currentColor"/><circle cx="12" cy="11.5" r=".6" fill="currentColor"/><circle cx="15.5" cy="11.5" r=".6" fill="currentColor"/></svg></button>
<div class="chat-panel" id="chatPanel" data-greeting={GREETING} role="dialog" aria-label="Pack Optical chat assistant" aria-modal="false">
  <div class="chat-head"><div class="avatar" aria-hidden="true">P</div><div><b>Pack Assistant</b><span>Answers from this website, 24/7</span></div><button class="chat-close" id="chatClose" aria-label="Close chat">✕</button></div>
  <div class="chips" id="chatChips" role="group" aria-label="Quick actions">{CHIPS.map((c) => <button type="button" class="chip" data-flow={c.flow} style={c.flow === 'urgent' ? 'border-color:#B3261E;color:#B3261E' : ''}>{c.label}</button>)}</div>
  <div class="chat-msgs" id="chatMsgs" role="log" aria-live="polite"></div>
  <form class="chat-input" id="chatForm"><label class="sr-only" for="chatText">Type your message</label><input id="chatText" placeholder="Book an exam, VSP?, glasses ready?" autocomplete="off" /><button type="submit">Send</button></form>
</div>
<script>
  import { reply } from '../lib/chat';
  const panel = document.getElementById('chatPanel')!, fab = document.getElementById('chatFab')!, msgs = document.getElementById('chatMsgs')!;
  const input = document.getElementById('chatText') as HTMLInputElement;
  let opener: HTMLElement | null = null;
  function add(kind: 'bot' | 'user', text: string, links: { label: string; href: string }[] = []) {
    const d = document.createElement('div'); d.className = 'msg ' + kind; d.textContent = text;
    links.forEach((l) => { const a = document.createElement('a'); a.className = 'btn btn-teal btn-sm'; a.href = l.href; a.textContent = l.label; if (/^https?:/.test(l.href)) { a.target = '_blank'; a.rel = 'noopener'; } d.append(document.createElement('br'), a); });
    msgs.append(d); msgs.scrollTop = msgs.scrollHeight;
  }
  function open(from?: HTMLElement) {
    opener = from ?? fab; panel.classList.add('open'); fab.setAttribute('aria-expanded', 'true');
    if (!msgs.childElementCount) add('bot', panel.dataset.greeting!);
    input.focus();
  }
  function close() { panel.classList.remove('open'); fab.setAttribute('aria-expanded', 'false'); opener?.focus(); }
  function ask(text: string) { add('user', text); const r = reply(text); setTimeout(() => add('bot', r.text, r.links), 250); }
  fab.addEventListener('click', () => (panel.classList.contains('open') ? close() : open()));
  document.getElementById('chatClose')!.addEventListener('click', close);
  document.querySelectorAll<HTMLElement>('[data-open-chat]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); open(b); }));
  document.querySelectorAll<HTMLElement>('#chatChips .chip').forEach((c) => c.addEventListener('click', () => ask(c.dataset.flow!)));
  document.getElementById('chatForm')!.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value.trim(); if (!v) return; input.value = ''; ask(v); });
  panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  if (location.hash === '#chat') open();
</script>
