---
import { SITE, NAV, SERVICE_SLUGS } from '../data/site';
import demo from '../data/demo-data.json';
const { path } = Astro.props as { path: string };
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const mobileLinks = [
  ['Home', '/'], ['Our Practice & Team', '/our-practice/'], ['All Services', '/services/'],
  ...demo.HUB.filter((h) => SERVICE_SLUGS[h[0]]).map((h) => [h[1], `/services/${SERVICE_SLUGS[h[0]]}/`]),
  ['Eyewear & 20 Brands', '/eyewear/'], ['Patient Centre', '/patient-centre/'], ['Offers', '/offers/'],
  ['Blog', '/blog/'], ['Location, Hours & Directions', '/visit/'], ['Book appointment →', '/book/'],
  ['Order Contacts', SITE.contactsOrderUrl],
];
---
<header class="site">
  <div class="wrap header-in">
    <a class="logo" href="/" aria-label="PACK. OPTICAL + MED SPA — home"><img src="/logo.svg" alt="Pack Optical + Med Spa" width="372" height="76" /></a>
    <nav class="main" aria-label="Main">
      {NAV.map((n) => <a href={n.href} class={active(n.href) ? 'active' : ''} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="head-actions">
      <a class="phone-link" href={SITE.contactsOrderUrl} target="_blank" rel="noopener" data-order-contacts>Order Contacts</a>
      <a class="phone-link" href={`tel:${SITE.phoneTel}`}>{SITE.phone}</a>
      <a class="btn btn-gold btn-sm" href="/book/">BOOK APPOINTMENT</a>
      <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">☰</button>
    </div>
  </div>
  <div class="wrap mobile-nav" id="mobileNav">
    {mobileLinks.map(([l, h]) => h.startsWith('http') ? <a href={h} target="_blank" rel="noopener">{l} ↗</a> : <a href={h}>{l}</a>)}
  </div>
</header>
