---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Turnstile from '../components/Turnstile.astro';
import { SITE } from '../data/site';
import { crumbs } from '../lib/schema';
import { SERVICE_OPTIONS, DAYS, TIMES } from '../lib/forms';
const items = [{ name: 'Home', href: '/' }, { name: 'Book', href: '/book/' }];
const groups = ['Eye care', 'Med spa'];
---
<Base title="Book an Eye Exam Fort Worth | Request an Appointment" description="Request an eye exam or med spa appointment at Pack Optical in Fort Worth, TX. Tell us your service and preferred day and our office will call to confirm." path="/book/" schema={crumbs(items)}>
<div class="wrap"><Breadcrumbs items={items} />
<div class="page-head"><p class="eyebrow">Request an appointment</p><h1>Request an eye care or med spa appointment</h1><p class="lead">Choose a service and a preferred day. This is a request, not a confirmed booking: our office will call you to confirm a time. For anything urgent, call <a href={`tel:${SITE.phoneTel}`}><b>{SITE.phone}</b></a>.</p></div>
<section class="block" style="padding-top:12px">
<div class="booking-shell"><div class="booking-head"><h2 style="font-size:23px;margin:0;color:#fff">Request an appointment</h2></div>
<div class="booking-body">
<form id="requestForm" novalidate aria-describedby="privacyNote">
  <div class="form-grid">
    <div class="field full"><label for="service">Service *</label>
      <select id="service" name="service" required><option value="">— Choose a service —</option>{groups.map((g) => <optgroup label={g}>{SERVICE_OPTIONS.filter((s) => s.group === g).map((s) => <option value={s.id}>{s.name}</option>)}</optgroup>)}</select>
      <p class="err" data-err="service" hidden></p></div>
    <div class="field"><label for="day">Preferred day *</label><select id="day" name="day" required><option value="">— Choose —</option>{DAYS.map((d) => <option>{d}</option>)}</select><p class="note" style="margin:0">Open Mon–Thu. Closed Fri–Sun.</p><p class="err" data-err="day" hidden></p></div>
    <div class="field"><label for="time">Preferred time of day *</label><select id="time" name="time" required><option value="">— Choose —</option>{TIMES.map((d) => <option>{d}</option>)}</select><p class="err" data-err="time" hidden></p></div>
    <div class="field"><label for="name">Full name *</label><input id="name" name="name" autocomplete="name" required placeholder="e.g. Jordan Smith" /><p class="err" data-err="name" hidden></p></div>
    <div class="field"><label for="phone">Mobile phone *</label><input id="phone" name="phone" inputmode="tel" autocomplete="tel" required placeholder="10-digit mobile number" /><p class="err" data-err="phone" hidden></p></div>
    <div class="field"><label for="email">Email (optional, for a confirmation copy)</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@email.com" /><p class="err" data-err="email" hidden></p></div>
    <div class="field"><label for="patientType">Are you a… *</label><select id="patientType" name="patientType"><option>New patient / client</option><option>Existing patient / client</option></select></div>
    <div class="field" style="position:absolute;left:-9999px" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
  </div>
  <p class="note" id="privacyNote" style="margin:14px 0"><b>Please do not enter health details, insurance numbers or dates of birth here.</b> We will gather anything clinical by phone or in person. By sending this you agree to a call or text about your request. See our <a href="/privacy/">privacy policy</a>.</p>
  <Turnstile />
  <p class="err" data-status role="alert" style="display:block;min-height:1em"></p>
  <div class="booking-nav"><span class="note">Walk-ins welcome during office hours.</span><button type="submit" class="btn btn-teal" data-label="Send request">Send request</button></div>
</form>
<div id="confirmPane" hidden class="confirm" tabindex="-1"><div class="big-check" aria-hidden="true">✓</div><h2 style="font-size:30px;margin:0">Request received</h2>
  <div class="ref" id="refCode">PACK-000000</div>
  <p style="max-width:52ch;margin:0 auto 12px">This is a <b>request</b>, not a confirmed appointment. Our office will call you to confirm a time. Please keep this reference handy.</p>
  <div class="summary" style="text-align:left;max-width:560px;margin:0 auto 14px" id="finalSummary"></div>
  <p class="note" style="max-width:52ch;margin:0 auto 16px">Arrive 10 minutes early for your visit; bring your insurance card and current glasses or contacts box. Need to change anything? Call <a href={`tel:${SITE.phoneTel}`}><b>{SITE.phone}</b></a>.</p>
  <a class="btn btn-ghost" href="/book/">Send another request</a></div>
</div></div></section>
</div>
<script>
  import { wireForm } from '../lib/formclient';
  const form = document.getElementById('requestForm') as HTMLFormElement;
  const pane = document.getElementById('confirmPane')!;
  const preset = new URLSearchParams(location.search).get('service'); if (preset) (form.elements.namedItem('service') as HTMLSelectElement).value = preset;
  wireForm(form, '/api/request', (reply, data) => {
    const svc = (form.elements.namedItem('service') as HTMLSelectElement); const label = svc.options[svc.selectedIndex].text;
    document.getElementById('refCode')!.textContent = reply.reference;
    const dl = document.createElement('dl'); dl.style.cssText = 'display:grid;grid-template-columns:130px 1fr;gap:6px 12px;margin:0';
    ([['Service', label], ['Preferred day', data.day], ['Preferred time', data.time], ['Name', data.name], ['Phone', data.phone]] as [string, string][]).forEach(([k, v]) => { const dt = document.createElement('dt'); dt.textContent = k; dt.style.fontWeight = '700'; const dd = document.createElement('dd'); dd.textContent = v; dd.style.margin = '0'; dl.append(dt, dd); });
    document.getElementById('finalSummary')!.replaceChildren(dl);
    form.hidden = true; pane.hidden = false; pane.focus(); window.scrollTo({ top: 0 });
  });
</script>
</Base>
