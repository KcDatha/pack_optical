---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import demo from '../data/demo-data.json';
import { SITE } from '../data/site';
import { crumbs } from '../lib/schema';
import eyewear from '../assets/eyewear.webp';
const items = [{ name: 'Home', href: '/' }, { name: 'Eyewear', href: '/eyewear/' }];
---
<Base title="Designer Eyeglasses Fort Worth | Frames & Lenses | Pack" description="Designer eyeglasses and sunglasses in Fort Worth, TX: 300+ frames from 20 brands, Essilor lenses, 15% off sunglasses and 10% senior discount. 817-831-6141." path="/eyewear/" schema={crumbs(items)} image={eyewear}>
<div class="wrap"><Breadcrumbs items={items} />
<div class="page-head"><p class="eyebrow">Eyewear — Sunglasses, Frames &amp; Lenses</p><h1>Eyewear that fits your life — 300+ frames</h1><p class="lead">Designer and budget frames, same-day pickup options, expert fitting and free adjustments. Lenses: single vision, bifocal, progressive, blue-light, photochromic, polarized and high-index — including Essilor Varilux® &amp; Crizal®.</p></div>
<Image src={eyewear} alt="Trying on designer frames in the Pack Optical boutique" widths={[640, 1100]} sizes="(max-width:1180px) 100vw, 1140px" style="border-radius:14px;width:100%;max-height:340px;object-fit:cover" />
<section class="block"><p class="kicker">All 20 brands</p><h2 class="title">On the wall right now</h2>
<div class="brands-grid">{demo.BRANDS.map((b) => <div class="brand-card"><b>{b[0]}</b><span>{b[1]}</span></div>)}</div>
<p class="note" style="margin-top:14px">Stock rotates — after a specific frame? Call <a href={`tel:${SITE.phoneTel}`}><b>{SITE.phone}</b></a> and we’ll check the wall for you. <a href={SITE.frameSelectorUrl} target="_blank" rel="noopener"><b>Try the Frame Selector ↗</b></a> · <a href={SITE.contactsOrderUrl} target="_blank" rel="noopener"><b>Order Contacts ↗</b></a></p>
<div class="offers-grid" style="margin-top:18px">
  <article class="offer"><p class="kicker" style="margin:0">Sunglasses</p><div class="price">15% off</div><p>Prescription and non-prescription sunglasses — Ray-Ban, Oakley, Michael Kors and more.</p></article>
  <article class="offer"><p class="kicker" style="margin:0">Seniors</p><div class="price">10% off</div><p>Senior discount on frames &amp; sunglasses.</p></article>
  <article class="offer"><p class="kicker" style="margin:0">Kids — Packs Unlimited</p><div class="price">$99 / year</div><p>Unlimited exams, $25 frame &amp; lens sets, $25 replacements, same-day pickup.</p></article>
</div>
<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px"><a class="btn btn-teal" href="/patient-centre/#frame-guide">Find frames for your face shape</a><a class="btn btn-gold" href="/book/">Book a styling visit</a></div></section>
</div>
</Base>
