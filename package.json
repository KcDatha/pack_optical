{
  "name": "pack-optical-med-spa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "images": "node scripts/images.mjs",
    "seo": "node scripts/seo-check.mjs",
    "links": "node scripts/check-links.mjs",
    "audit": "node scripts/audit-content.mjs",
    "build:staging": "PUBLIC_NOINDEX=1 astro build && node scripts/staging-post.mjs",
    "check:staging": "node scripts/staging-check.mjs",
    "deploy:staging": "npm run build:staging && npm run check:staging && wrangler pages deploy dist --project-name=$CF_PAGES_PROJECT --branch=staging",
    "check:csp": "node scripts/csp-check.mjs",
    "facts": "node scripts/facts-check.mjs",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "tailwindcss": "^4.3.5",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
